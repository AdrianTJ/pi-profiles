# Machine-specific values for the pi profiles. Copy to .env and fill in.
# .env is git-ignored. Pi does not read this file.

# Absolute path to your Agent Skills store (~/.agents/skills on your machine).
# profiles/marathon/settings.json uses ${AGENTS_SKILLS_DIR} as a placeholder.
# Replace it with this value in your local profile settings.
AGENTS_SKILLS_DIR=/absolute/path/to/home/.agents/skills

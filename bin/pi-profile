#!/usr/bin/env bash
# pi-profile — run pi against a per-profile config dir, with shared session history.
#
# A profile is a full pi config directory (~/.pi/profiles/<name>), isolated via
# PI_CODING_AGENT_DIR. Sessions stay shared via PI_CODING_AGENT_SESSION_DIR.
#
# Usage:
#   pi-profile                 interactive profile picker
#   pi-profile list            what each profile is for and what it installs
#   pi-profile list -1         the same list, one line per profile
#   pi-profile show <name>     print a profile's full description
#   pi-profile create <name> [--from <name>|--from base]
#   pi-profile pack <name> [outdir]                  export a shareable profile
#   pi-profile install <owner>/<repo>|<dir> [name]   install a shared profile
#   pi-profile <name> [pi args...]
#   pi-profile help
#
# Shared into every profile at create time (symlinks, never copies):
#   auth.json models-store.json AGENTS.md trust.json extensions/
# extensions/ is shared because tools install their own files into the base agent
# dir (Orca's managed status extension, for example) and Pi only discovers
# extensions under the active agent dir, so a profile loads none of them.
# Everything else (settings.json, skills/, APPEND_SYSTEM.md) is
# per-profile. Add more sharing manually: ln -s ~/.pi/agent/<item> ~/.pi/profiles/<name>/

set -euo pipefail

# Resolve real path through symlinks (~/.local/bin/pi-profile → repo).
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR=$(cd "$(dirname "$SOURCE")" && pwd)
  SOURCE=$(readlink "$SOURCE")
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
REPO_DIR=$(cd "$(dirname "$SOURCE")/.." && pwd)
BADGE_TS="$REPO_DIR/extensions/profile-badge.ts"

PROFILES_ROOT="${PI_PROFILES_ROOT:-$HOME/.pi/profiles}"
BASE_DIR="${PI_PROFILE_BASE_DIR:-$HOME/.pi/agent}"
SHARED_SESSIONS="${PI_PROFILE_SESSIONS:-$BASE_DIR/sessions}"
# ponytail: fixed share list; promote to a config file if it keeps growing
SHARED_ITEMS=(auth.json models-store.json AGENTS.md trust.json extensions)
# What pack/install copy. Credentials and state are shared by symlink instead —
# this whitelist is the whole secret-safety story: real files only, never links.
# New root-level configs (e.g. sol-pi.json) get an explicit entry here, never a
# wildcard, so a future credential file can never match by accident.
PORTABLE_FILES=(settings.json APPEND_SYSTEM.md sol-pi.json DESCRIPTION.md)
PORTABLE_DIRS=(skills prompts extensions)

# Copy a file/dir tree skipping symlinks entirely (never copy or follow them).
portable_cp() {
  local src="$1" dst="$2" entry
  [ -L "$src" ] && return 0
  if [ -f "$src" ]; then cp "$src" "$dst"; return 0; fi
  mkdir -p "$dst"
  for entry in "$src"/*; do
    [ -e "$entry" ] || continue
    [ -L "$entry" ] && continue
    if [ -d "$entry" ]; then portable_cp "$entry" "$dst/$(basename "$entry")"
    else cp "$entry" "$dst/"; fi
  done
}

# Copy the portable whitelist from a profile or bundle dir into dst.
copy_portable() {
  local src="$1" dst="$2" item
  for item in "${PORTABLE_FILES[@]}"; do
    [ -f "$src/$item" ] && [ ! -L "$src/$item" ] && cp "$src/$item" "$dst/"
  done
  for item in "${PORTABLE_DIRS[@]}"; do
    [ -d "$src/$item" ] || continue
    # Never write through a shared symlink: a profile's extensions/ points at the
    # base agent dir, so copying bundle files there would drop them into base.
    if [ -L "$dst/$item" ]; then
      [ -n "$(find "$src/$item" -type f -print -quit 2>/dev/null)" ] &&
        echo "pi-profile: bundle has $item/ files but $dst/$item is a shared symlink, not copied" >&2
      continue
    fi
    portable_cp "$src/$item" "$dst/$item"
  done
}

init_profile_dir() {
  local name="$1"
  mkdir -p "$PROFILES_ROOT/$name/skills"

  # Share credentials and global instructions by symlink — never copy secrets.
  local item
  for item in "${SHARED_ITEMS[@]}"; do
    if [ -e "$BASE_DIR/$item" ]; then
      ln -s "$BASE_DIR/$item" "$PROFILES_ROOT/$name/$item"
    fi
  done
}

die() { echo "pi-profile: $*" >&2; exit 1; }
list_profiles() { if [ -d "$PROFILES_ROOT" ]; then ls -1 "$PROFILES_ROOT"; fi; }

# One-line summary shown in lists and the picker: the first non-blank line of
# DESCRIPTION.md that is not a heading.
profile_summary() {
  local file="$PROFILES_ROOT/$1/DESCRIPTION.md"
  [ -f "$file" ] || { printf 'no description yet\n'; return; }
  awk 'NF && $0 !~ /^#/ { sub(/^[[:space:]]+/, ""); sub(/[[:space:]]+$/, ""); print; exit }' "$file"
}

# Starter file so a new profile shows up in `list` with something to fill in.
write_starter_description() {
  local name="$1" dir="$PROFILES_ROOT/$1"
  [ -f "$dir/DESCRIPTION.md" ] && return 0
  cat > "$dir/DESCRIPTION.md" <<EOF
# $name

One line on what this profile is for and when to reach for it instead of another one.

Use it when: the situation that should make you pick this profile.
EOF
}

# Live inventory, read from the profile at list time so it cannot drift from what
# is actually installed. One array per call, flattened by tr. No jq/python here:
# the wrapper otherwise has no dependencies beyond bash and git.
json_array() { # file key
  [ -f "$1" ] || return 0
  tr -d '\n' < "$1" | sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\[\([^]]*\)\].*/\1/p" |
    tr ',' '\n' | sed -e 's/^[[:space:]]*"//' -e 's/"[[:space:]]*$//' | grep . || true
}

profile_inventory() { # name
  local dir="$PROFILES_ROOT/$1" pkgs skills cfg f
  # paste -d takes one char per column, so join on a comma and space it afterwards.
  pkgs="$(json_array "$dir/settings.json" packages | sed 's/^npm://' | paste -sd ',' - | sed 's/,/, /g')"
  printf '  packages: %s\n' "${pkgs:-none}"
  skills="$(ls -1 "$dir/skills" 2>/dev/null | paste -sd ',' - | sed 's/,/, /g')"
  [ -n "$skills" ] && printf '  skills:   %s\n' "$skills"
  cfg=""
  for f in APPEND_SYSTEM.md sol-pi.json nolo.json; do
    [ -f "$dir/$f" ] && cfg="${cfg:+$cfg, }$f"
  done
  [ -n "$cfg" ] && printf '  config:   %s\n' "$cfg"
  return 0
}

cmd_create() {
  local name="" from=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) from="$2"; shift 2 ;;
      *) [ -z "$name" ] || die "unexpected argument: $1"; name="$1"; shift ;;
    esac
  done
  [ -n "$name" ] || die "usage: pi-profile create <name> [--from <name>|--from base]"
  [[ "$name" =~ ^[a-zA-Z0-9_-]+$ ]] || die "profile name may contain only letters, digits, - and _"
  local dir="$PROFILES_ROOT/$name"
  [ -e "$dir" ] && die "profile already exists: $name"

  init_profile_dir "$name"

  case "$from" in
    "")
      if [ -f "$BADGE_TS" ]; then
        printf '{"extensions":["%s"]}\n' "$BADGE_TS" > "$dir/settings.json"
      else
        printf '{}\n' > "$dir/settings.json"
      fi
      ;;
    base) cp "$BASE_DIR/settings.json" "$dir/settings.json" ;;
    *)
      [ -d "$PROFILES_ROOT/$from" ] || die "no such profile to copy from: $from"
      cp "$PROFILES_ROOT/$from/settings.json" "$dir/settings.json"
      ;;
  esac

  write_starter_description "$name"

  echo "Created profile '$name' at $dir"
  echo "Describe it: $dir/DESCRIPTION.md (shown by: pi-profile list)"
  echo "Customize: $dir/settings.json, $dir/skills/, $dir/extensions/"
}

cmd_pack() {
  local name="${1:-}" out="${2:-}"
  if [ -z "$name" ] || [ -n "${3:-}" ]; then die "usage: pi-profile pack <name> [outdir]"; fi
  local dir="$PROFILES_ROOT/$name"
  [ -d "$dir" ] || die "no such profile: $name"
  out="${out:-$PWD/$name}"
  [ -e "$out" ] && die "output dir already exists: $out"
  mkdir -p "$out"

  # Advertise whichever repo this wrapper came from — forks point at themselves.
  local wrap_url
  wrap_url="$(git -C "$REPO_DIR" remote get-url origin 2>/dev/null | sed -e 's|^git@github.com:|https://github.com/|' -e 's|\.git$||' || true)"
  [ -n "$wrap_url" ] || wrap_url="<pi-profile wrapper repo>"

  # Whitelist copy — real files only; credentials/state live behind symlinks
  # and portable_cp skips those, so they cannot leak into the bundle.
  copy_portable "$dir" "$out"

  cat > "$out/README.md" <<EOF
# pi profile: $name

A shareable config profile for the [pi coding agent](https://github.com/earendil-works/pi), installed with
the pi-profile wrapper: $wrap_url

## Install

\`\`\`sh
pi-profile install <owner>/<this-repo-name>
\`\`\`

Packages declared in settings.json are re-fetched from npm/git on first launch —
nothing here is vendored.

## Notes

- Credentials (auth.json, models-store.json) are deliberately not included;
  they are symlinked from your global config at install time.
- Extension entries in settings.json pointing at absolute local paths won't
  resolve on other machines. Publish those extensions as npm/git packages.
- Trust model: installing a profile runs its declared packages, same as any
  npm install. Read settings.json before installing someone else's profile.
EOF

  echo "Packed '$name' → $out"
  [ -f "$out/DESCRIPTION.md" ] || echo "Note: no DESCRIPTION.md in $name, so installers see no summary."
  echo "Publish: cd $out && git init -b main && git add -A && git commit -m 'pack: $name' && git push"
}

cmd_list() {
  local name width=0
  if [ "${1:-}" = "-1" ] || [ "${1:-}" = "--short" ]; then
    for name in $(list_profiles); do [ ${#name} -gt $width ] && width=${#name}; done
    for name in $(list_profiles); do
      printf '%-*s  %s\n' "$width" "$name" "$(profile_summary "$name")"
    done
    return 0
  fi
  local first=1
  for name in $(list_profiles); do
    [ $first -eq 1 ] || echo
    first=0
    printf '%s — %s\n' "$name" "$(profile_summary "$name")"
    # Remaining prose: the headline is already printed, and inventory comes live
    # from the profile, so an "Installed:" line in the file would be duplicated.
    [ -f "$PROFILES_ROOT/$name/DESCRIPTION.md" ] &&
      awk 'NF && $0 !~ /^#/ { n++; if (n == 1 || $0 ~ /^Installed:/) next; print "  " $0 }' \
        "$PROFILES_ROOT/$name/DESCRIPTION.md"
    profile_inventory "$name"
  done
}

cmd_show() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: pi-profile show <name>"
  [ -d "$PROFILES_ROOT/$name" ] || die "no such profile: $name"
  if [ -f "$PROFILES_ROOT/$name/DESCRIPTION.md" ]; then
    cat "$PROFILES_ROOT/$name/DESCRIPTION.md"
  else
    echo "# $name"
    echo
    echo "no description yet ($PROFILES_ROOT/$name/DESCRIPTION.md)"
  fi
  echo
  profile_inventory "$name"
}

cmd_install() {
  local src="${1:-}" name="${2:-}"
  if [ -z "$src" ] || [ -n "${3:-}" ]; then die "usage: pi-profile install <owner>/<repo>|<dir> [name]"; fi

  local tmp=""
  if [ -d "$src" ]; then
    # Local path — also how packed profiles get tested before pushing.
    [ -z "$name" ] && { name="$(basename "$src")"; }
  else
    command -v git >/dev/null || die "git is required to install from GitHub"
    src="${src#*github.com/}"; src="${src%.git}"
    [[ "$src" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]] || die "expected <owner>/<repo> or a local dir, got: ${1}"
    [ -z "$name" ] && { name="${src##*/}"; name="${name#pi-}"; }
  fi
  # Validate the name and target before cloning so a rejected install doesn't
  # leave a temp clone behind.
  [[ "$name" =~ ^[a-zA-Z0-9_-]+$ ]] || die "profile name may contain only letters, digits, - and _"
  [ -e "$PROFILES_ROOT/$name" ] && die "profile already exists: $name"

  if [ ! -d "$src" ]; then
    tmp="$(mktemp -d)"
    git clone -q --depth 1 "https://github.com/$src.git" "$tmp/src" || { rm -rf "$tmp"; die "clone failed: $src"; }
    src="$tmp/src"
  fi

  init_profile_dir "$name"
  local dir="$PROFILES_ROOT/$name"
  copy_portable "$src" "$dir"
  [ -f "$dir/settings.json" ] || printf '{}\n' > "$dir/settings.json"
  write_starter_description "$name"
  [ -n "$tmp" ] && rm -rf "$tmp"

  echo "Installed as profile '$name' at $dir"
  echo "Launch: pi-profile $name   (packages fetch on first run)"
}

cmd_pick_and_run() {
  local names name rows choice
  names="$(list_profiles)"
  [ -n "$names" ] || die "no profiles yet — create one: pi-profile create <name>"

  if command -v fzf >/dev/null 2>&1; then
    # Tab-separated so the summary is visible but only the name is returned.
    rows=""
    while IFS= read -r name; do
      rows+="$(printf '%s\t%s\n' "$name" "$(profile_summary "$name")")"$'\n'
    done <<< "$names"
    choice="$(printf '%s' "$rows" | fzf --delimiter='\t' --with-nth=1,2 --prompt='pi profile: ')" || exit 0
    choice="${choice%%$'\t'*}"
  else
    echo "(pi-profile list shows each profile's description)" >&2
    select choice in $names; do [ -n "$choice" ] && break; done
    [ -n "${choice:-}" ] || exit 0
  fi
  exec_profile "$choice"
}

exec_profile() {
  local name="$1"; shift
  local dir="$PROFILES_ROOT/$name"
  [ -d "$dir" ] || { echo "no such profile: $name (see: pi-profile list)" >&2; exit 1; }
  command -v pi >/dev/null 2>&1 || die "pi not found on PATH"
  export PI_CODING_AGENT_DIR="$dir"
  export PI_CODING_AGENT_SESSION_DIR="$SHARED_SESSIONS"
  exec pi "$@"
}

case "${1:-}" in
  help|-h|--help|"")
    if [ -z "${1:-}" ] && [ -t 0 ]; then cmd_pick_and_run; exit 0; fi
    sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  list) shift; cmd_list "$@" ;;
  show) shift; cmd_show "$@" ;;
  create) shift; cmd_create "$@" ;;
  pack) shift; cmd_pack "$@" ;;
  install) shift; cmd_install "$@" ;;
  *) exec_profile "$@" ;;  # anything else: first arg must be a profile name
esac

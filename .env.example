# Machine-specific values for the pi profiles. Copy to .env and fill in.
# .env is git-ignored.
#
# Pi does not read this file. The profile settings in `profiles/` carry these
# names as `${PLACEHOLDER}` strings so no personal path is committed. After
# `pi-profile install` or `pi-profile create`, replace each placeholder in
# ~/.pi/profiles/<name>/settings.json with the absolute path on that machine.
# Pi expands `~` in paths but not environment variables.

# Your Agent Skills store (~/.agents/skills). Used by profiles/marathon as an
# exclude pattern so the store's skills stay out of unattended campaigns.
AGENTS_SKILLS_DIR=/absolute/path/to/home/.agents/skills

# A checkout of this repo. Used by profiles/research, work, pi-profiles and
# SoL-Pi to load extensions/profile-badge.ts.
PI_PROFILES_DIR=/absolute/path/to/pi-profiles

# A checkout of the AlterWiki extension. Used by profiles/alterwiki.
ALTERWIKI_DIR=/absolute/path/to/AlterWiki
